# GEMINI_API_KEY: Khóa Gemini cho các tính năng Trợ lí AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL ứng dụng đang chạy (dùng cho liên kết tự tham chiếu).
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Cơ sở dữ liệu tập trung (Supabase) – bắt buộc nếu muốn đồng bộ đa thiết bị.
# Chỉ đặt ở phía máy chủ, KHÔNG đưa service_role key xuống trình duyệt.
# ---------------------------------------------------------------------------
# Project URL, dạng https://<project-ref>.supabase.co
SUPABASE_URL=""

# Khóa bí mật phía máy chủ: dán "Secret key" (sb_secret_...) hoặc service_role key.
# Tuyệt đối không đưa khóa này xuống trình duyệt hay commit lên GitHub.
SUPABASE_SERVICE_ROLE_KEY=""

# Tùy chọn: "Publishable key" (sb_publishable_...). Máy chủ hiện không dùng.
# SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Tùy chọn: nơi lưu tệp JSON khi CHƯA cấu hình Supabase (mặc định ./.data).
# Trên Render, thư mục này là bộ nhớ tạm và có thể mất khi redeploy.
# ---------------------------------------------------------------------------
# DATA_DIR="./.data"